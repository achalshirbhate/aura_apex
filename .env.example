# Aura Apex Environment Variable Configuration Template
# DO NOT add real secret keys to this file or commit real credentials to GitHub.
# Configure these variables in your Vercel Dashboard -> Settings -> Environment Variables.

# PostgreSQL Connection String (e.g. Neon, Supabase, Vercel Postgres)
DATABASE_URL=postgres://user:password@ep-sample.neon.tech/auraapex?sslmode=require

# Transactional Email Service API Key (Resend.com)
RESEND_API_KEY=re_1234567890abcdef

# Notification Email Address for Aura Apex Admin Notifications
CONTACT_EMAIL=auraapex04@gmail.com
